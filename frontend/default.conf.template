server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /api/products {
        proxy_pass http://${PRODUCT_API_HOST}:5001/products;
    }
    location ^~ /api/products/ {
        rewrite ^/api/products/(.*)$ /products/$1 break;
        proxy_pass http://${PRODUCT_API_HOST}:5001;
    }
    location = /api/orders {
        proxy_pass http://${ORDER_API_HOST}:5002/orders;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
